# =============================================
#  SERVER CONFIGURATION
# =============================================
PORT=5000
NODE_ENV=development

# =============================================
#  DATABASE CONFIGURATION
# =============================================
# Local MongoDB
MONGODB_URI=mongodb://localhost:27017/forma_ai

# For MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/forma_ai

# =============================================
#  JWT AUTHENTICATION
# =============================================
# Generate a secure key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# =============================================
#  CLIENT CONFIGURATION
# =============================================
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================
#  AI SERVICE CONFIGURATION
# =============================================
# AI Service URL (if using external AI service)
AI_SERVICE_URL=http://localhost:5001
AI_API_KEY=your_ai_api_key_here

# =============================================
#  RATE LIMITING
# =============================================
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# =============================================
#  FILE UPLOAD (Optional)
# =============================================
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads/

# =============================================
#  EMAIL (Optional)
# =============================================
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password
# EMAIL_FROM=noreply@forma-ai.com

# =============================================
#  CLOUDINARY (Optional)
# =============================================
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# =============================================
#  REDIS (Optional)
# =============================================
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=

# =============================================
#  LOGGING (Optional)
# =============================================
LOG_LEVEL=debug
LOG_FILE=logs/combined.log
